1) useState() -> It allows you to create and manage a state variable in a React functional component.

-----------without usestate--------------
import React from 'react'

function WithoutState() {
    var x=10;
    function updateAk(){
        x=15;
        console.log(x);
    }

  return (
    <>
       <h1> akState{x}</h1>
       <button onClick={updateAk}>Click</button>
    </>
  )
}

export default WithoutState
----------------------output => not change x value on screen only change in console.

------------usestate--------------
import React, { useState } from 'react'

function State() {
    const [x, setx] = useState(0); // Line 1: State initialize hoti hai - start flow of execution.

    function updateAk() {
        setx(15); // Line 2: State ko update karne ka kaam schedule hota hai
        console.log(x); // Line 3: Current state ko console mein log karte hain
    }

    return (
        <>
            <h1>akState{x}</h1> {/* Line 4: JSX render hota hai */}
            <button onClick={updateAk}>Click</button> {/* Line 5: Button render hota hai */}
        </>
    );
}

export default State;

  
----------------------output => Also change x value on screen also change in console.
// component are local update means agr same component ko boht time call krde aur jis component button pe click krenge usi component ka value update dusre component ka nhi.
--------------Flow of Lines (Order of Execution)------------------------------
Initial Render:
Line 1: const [x, setx] = useState(0);
Line 4: <h1>akState{x}</h1>
Line 5: <button onClick={updateAk}>Click</button>
my-line - And , whenever the updateAk function update the value then after this whole component re-render .

After Button Click:
Line 2: setx(15); (Schedules state update)
Line 3: console.log(x); (Logs the old value, 0)

Re-render Starts:
Line 1: useState runs with updated x (15).
Line 4: <h1>akState15</h1> renders.
Line 5: Button re-renders.


ex-2 - counter increment,decrement

import React, { useState } from 'react'


function App() {
  const [x, setx] = useState(1)

  const incre = () => {
    setx(x + 1)
  }

  const decre = () => {
    setx(x - 1)
  }
  return (
    <div>
      <h1 className="text-gray-900">Counter App</h1>
      <h3>Count: {x}</h3>
      <button className="bg-sky-50" onClick={incre}>Increment</button>
      <button onClick={decre}>Decrement</button>
    </div>

  )
}

export default App


