ex-2 - counter increment,decrement

import React, { useState } from 'react'


function App() {
  const [x, setx] = useState(1)

  const incre = () => {
    setx(x + 1)
  }

  const decre = () => {
    setx(x - 1)
  }
  return (
    <div>
      <h1 className="text-gray-900">Counter App</h1>
      <h3>Count: {x}</h3>
      <button className="bg-sky-50" onClick={incre}>Increment</button>
      <button onClick={decre}>Decrement</button>
    </div>

  )
}

export default App


2) useEffect() -> useEffect is a React Hook that lets you run side effects in your components.
💡 Side effects examples:
Fetching data from an API
