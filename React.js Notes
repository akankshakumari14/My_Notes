------------Form Handling--------------------
import React, { useState } from 'react'

function App() {

  const [username, setUsername] = useState('')
  const valueChange = (e) => {
    setUsername(e.target.value)
  }
  const submitHandler = (e) => {
    e.preventDefault()          // stops the page from reloading,ye nhi likhte to page reload hojata aur console value show nhi ho pata reload ke karan
    console.log(username)       // prints the name in console
    setUsername('')             // clears the input box
  }

  return (
    <div>
      <form onSubmit={submitHandler}>
        <input type="text" placeholder='Enter Your Name' value={username} onChange={valueChange}></input>
        {/* agr onChange event nhi chlate to input box mein mein likh paate jo intial value pass ho rha hota useState mein sirf whi show hota input box mein,aisa kr paa rhe ye hua two binding and form handling */}
        <button type='submit'>Submit</button>
      </form>
    </div>
  )
}

export default App


