In App.jsx:-
import React, { createContext, useState } from 'react'
import ChildA from './components/ChildA'

const AkContext = createContext()
function App() {

  const [mk, setMk] = useState({ name: "maunti" })
  return (
    <>
      <AkContext.Provider value={mk}>
        <ChildA />
      </AkContext.Provider>

    </>
  )
}


export default App
